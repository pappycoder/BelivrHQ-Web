# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Backend API
NEXT_PUBLIC_API_URL=http://localhost:3001

# Canonicals, sitemap and social cards: use the production public origin, including on previews.
# Falls back to VERCEL_PROJECT_PRODUCTION_URL, then the existing BelivrHQ deployment.
NEXT_PUBLIC_SITE_URL=https://church-os-web.vercel.app
# Optional ownership verification tokens; rendered only when configured.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Push Notifications (VAPID keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key

# Sentry (error monitoring + session replay). Fill in real values.
# The client DSN must be public; SENTRY_DSN may be the same or a server-only DSN.
NEXT_PUBLIC_SENTRY_DSN=https://<dsn>@o<org-id>.ingest.sentry.io/<project-id>
SENTRY_DSN=https://<dsn>@o<org-id>.ingest.sentry.io/<project-id>
# Opt-in to client-side Sentry in dev (inlined). Don't set in prod.
NEXT_PUBLIC_SENTRY_DEBUG=

# Used by the build to upload source maps (set as a CI secret, not client-side).
SENTRY_ORG=<your-sentry-org-slug>
SENTRY_PROJECT=<your-sentry-project-slug>
SENTRY_AUTH_TOKEN=<your-sentry-auth-token>

# Server-only upstream origin used by the HttpOnly session proxy.
API_URL=http://localhost:3001
# Match the backend secret; never prefix this with NEXT_PUBLIC_.
# INTERNAL_PROXY_SECRET=
# Replay remains disabled unless explicitly enabled; content is masked.
NEXT_PUBLIC_SENTRY_REPLAY=0
