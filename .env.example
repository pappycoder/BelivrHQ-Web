# BelivrHQ web configuration reference. Copy to .env.local.
# Unique deployment values/keys must be configured; reusable defaults live in code.

# Required public Supabase connection. Never put the service-role key in the web app.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required on hosted deployments; server-only. Local default: http://localhost:3001.
API_URL=
# Optional explicit canonical origin. Code falls back to
# VERCEL_PROJECT_PRODUCTION_URL, then the retained public deployment origin.
NEXT_PUBLIC_SITE_URL=

# Private shared proxy secret, when enabled. Must match the backend value.
INTERNAL_PROXY_SECRET=

# Optional Sentry monitoring and build-only source-map upload credentials.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# Server/edge use the public DSN by default. Set only for a different server DSN.
# SENTRY_DSN=

# Optional unique search-engine ownership verification tokens.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Reusable defaults: both are off unless explicitly enabled.
NEXT_PUBLIC_SENTRY_DEBUG=0
NEXT_PUBLIC_SENTRY_REPLAY=0
